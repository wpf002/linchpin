{
  "name": "linchpin",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @linchpin/db exec prisma generate",
    "db:migrate": "pnpm --filter @linchpin/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @linchpin/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @linchpin/db exec prisma studio",
    "db:seed": "pnpm --filter @linchpin/db exec tsx prisma/seed.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "@types/node": "22.18.8",
    "prettier": "3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ]
  }
}
